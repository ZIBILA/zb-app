<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:windowBackground">@color/splashscreen_background_light</item>
    <item name="android:colorBackground">@color/splashscreen_background_light</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/splashscreen_background_light</item>
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
  </style>

  <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:windowBackground">@color/splashscreen_background_dark</item>
    <item name="android:colorBackground">@color/splashscreen_background_dark</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/splashscreen_background_dark</item>
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
  </style>

  <!-- Default / light splash — never follows system dark mode -->
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background_light</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="windowSplashScreenIconBackgroundColor">@color/splashscreen_background_light</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
  </style>

  <!-- Used only when the in-app theme was explicitly saved as dark -->
  <style name="Theme.App.SplashScreen.Dark" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background_dark</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="windowSplashScreenIconBackgroundColor">@color/splashscreen_background_dark</item>
    <item name="postSplashScreenTheme">@style/AppTheme.Dark</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
  </style>
</resources>
