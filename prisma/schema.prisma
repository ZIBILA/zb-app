/// Global Multi-Country Storefront — country/currency configuration
model GlobalStoreCountry {
  id             String   @id @default(cuid())
  code           String   @unique // ISO 3166-1 alpha-2: IN, US, GB, CA, AU, AE, DE, ES
  name           String // "United States"
  currencyCode   String   @map("currency_code") // ISO 4217: USD, GBP, CAD, AUD, AED, EUR, INR
  currencySymbol String   @map("currency_symbol") // $, £, $, $, د.إ, €, ₹
  locale         String   @default("en-IN") // BCP 47 locale for Intl.NumberFormat
  isBase         Boolean  @default(false) // true only for IN — locks multiplier at 1.0
  multiplier     Decimal  @default(1.0) @db.Decimal(10, 4) // e.g. 2.5 — applied to INR base price
  exchangeRate   Decimal  @db.Decimal(12, 6) // INR → currencyCode conversion rate, admin-editable
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("global_store_countries")
}

