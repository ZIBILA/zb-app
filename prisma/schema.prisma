enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateReferralStatus {
  PENDING
  CONFIRMED
  REVERSED
  PAID
}

enum AffiliateWithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum AffiliateLedgerType {
  CREDIT
  DEBIT
  REVERSAL
  HOLD
  RELEASE
}

enum AffiliatePayoutMethod {
  BANK
  UPI
}

model Affiliate {
  id               String          @id @default(cuid())
  customerId       String          @unique @map("customer_id")
  code             String          @unique
  displayName      String?         @map("display_name")
  status           AffiliateStatus @default(PENDING)
  commissionRate   Float           @default(0.10) @map("commission_rate")
  appliedAt        DateTime        @default(now()) @map("applied_at")
  approvedAt       DateTime?       @map("approved_at")
  approvedByUserId String?         @map("approved_by_user_id")
  rejectedReason   String?         @map("rejected_reason")
  notes            String?

  totalClicks         Int     @default(0) @map("total_clicks")
  totalConversions    Int     @default(0) @map("total_conversions")
  totalRevenue        Float   @default(0) @map("total_revenue")
  pendingEarnings     Float   @default(0) @map("pending_earnings")
  availableBalance    Float   @default(0) @map("available_balance")
  lifetimeEarnings    Float   @default(0) @map("lifetime_earnings")
  paidOut             Float   @default(0) @map("paid_out")
  firstWithdrawalDone Boolean @default(false) @map("first_withdrawal_done")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer       Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  links          AffiliateLink[]
  clicks         AffiliateClick[]
  referrals      AffiliateReferral[]
  payoutAccounts AffiliatePayoutAccount[]
  withdrawals    AffiliateWithdrawal[]
  ledger         AffiliateLedgerEntry[]

  @@index([status, createdAt])
  @@index([code])
  @@map("affiliates")
}

model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String   @map("affiliate_id")
  slug        String   @unique
  label       String?
  targetType  String   @default("STORE") @map("target_type")
  targetValue String?  @map("target_value")
