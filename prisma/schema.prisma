  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("affiliate_payout_accounts")
}

model AffiliateWithdrawal {
  id               String                    @id @default(cuid())
  affiliateId      String                    @map("affiliate_id")
  payoutAccountId  String?                   @map("payout_account_id")
  amount           Float
  status           AffiliateWithdrawalStatus @default(REQUESTED)
  requestedAt      DateTime                  @default(now()) @map("requested_at")
  reviewedByUserId String?                   @map("reviewed_by_user_id")
  reviewedAt       DateTime?                 @map("reviewed_at")
  rejectionReason  String?                   @map("rejection_reason")
  payoutProvider   String?                   @map("payout_provider")
  payoutRef        String?                   @map("payout_ref")
  paidAt           DateTime?                 @map("paid_at")
  idempotencyKey   String                    @unique @map("idempotency_key")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status, requestedAt])
  @@index([status, requestedAt])
  @@map("affiliate_withdrawals")
}

model AffiliateLedgerEntry {
  id           String              @id @default(cuid())
  affiliateId  String              @map("affiliate_id")
  type         AffiliateLedgerType
  amount       Float
  balanceAfter Float               @map("balance_after")
  referralId   String?             @map("referral_id")
  withdrawalId String?             @map("withdrawal_id")
  reason       String?
  createdAt    DateTime            @default(now()) @map("created_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@map("affiliate_ledger_entries")
}
