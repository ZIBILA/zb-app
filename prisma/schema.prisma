generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id                       String     @id @default(cuid())
  domain                   String     @unique
  accessToken              String
  installedAt              DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  delhiveryApiKey          String?
  razorpayKeyId            String?
  razorpayKeySecret        String?
  shiprocketEmail          String?
  shiprocketToken          String?
  webhookSecret            String?
  heroImage                String?
  heroVideo                String?
  heroTitle                String?
  heroSubtitle             String?
  heroButtonText           String?    @default("Discover")
  latestCurationTitle      String?    @default("Latest curation")
  latestCurationSubtitle   String?    @default("Season Drop")
  archiveTitle             String?    @default("The Archive")
  archiveSubtitle          String?    @default("Organic Evolution")
  blueprintTitle           String?    @default("The blueprint of Zica Bella")
  blueprintSubtitle        String?    @default("Technique & Motion")
  showHeroText             Boolean    @default(false)
  showLatestCuration       Boolean    @default(true)
  showArchive              Boolean    @default(true)
  showBlueprint            Boolean    @default(true)
  showProductVideo         Boolean    @default(true)
  showSizeChart            Boolean    @default(true)
  showBrand                Boolean    @default(true)
  showShippingReturn       Boolean    @default(true)
  showCare                 Boolean    @default(true)
  showSizeFit              Boolean    @default(true)
  showDetails              Boolean    @default(true)
  pdpBackground            String?
  instagramUrl             String?
  appleUrl                 String?
  spotifyUrl               String?
  youtubeUrl               String?
  featuredMedia            String?
  collectionsMedia         String?
  footerVideo              String?
  mainMenuHandle           String?
  secondaryMenuHandle      String?
  showTreeText             Boolean    @default(true)
  enabledCollectionsHeader String?
  enabledCollectionsPage   String?
  enabledCollectionsMenu   String?
  featuredMediaImage       String?
  kineticMeshProducts      String?
  communitySubtitle        String?    @default("Community")
  communityTitle           String?    @default("Featured Looks")
  kineticMeshTitle         String?    @default("ARCHIVE EDITION")
  showCommunity            Boolean    @default(true)
  spotlightSubtitle        String?    @default("Luxury Indian streetwear for modern men. Redefining bold everyday style.")
  spotlightTitle           String?    @default("AUTHENTIC STREETWEAR")
  chatAccessMode           String     @default("open")
  communityAgeRestricted   Boolean    @default(true)
  communityMinOrders       Int        @default(1)
  communityWhatsAppEnabled Boolean    @default(true)
  flipbookConfig           String?    @default("[]")
  flipbookDesc             String?    @default("Engineered for those who move without compromise.")
  flipbookImage            String?
  flipbookTag              String?    @default("Core Manifest")
  flipbookTitle            String?    @default("Archival Vision")
  flipbookVideo            String?
  ringCarouselItems        String?    @default("[]")
  ringCarouselTitle        String?    @default("RING COLLECTION")
  showRingCarousel         Boolean    @default(true)
  spotlightCollection      String?    @default("tshirts")
  spotlightProducts        String?    @default("")
  shiprocketPassword       String?
  firebaseClientEmail      String?
  firebasePrivateKey       String?
  firebaseProjectId        String?
  sendgridApiKey           String?
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  whatsappPhoneId          String?
  whatsappToken            String?
  footerLogo3dUrl          String?    @default("https://cdn.shopify.com/3d/models/e024b09e83a75c03/Zicabella-silver-logo.glb")
  spotlightMedia           String?
  claudeApiKey             String?
  claudeWebhookSecret      String?
  openaiApiKey             String?
  openaiWebhookSecret      String?
  homepageCollection       String?    @default("")
  homepageProducts         String?    @default("")
  heroVideoMobile          String?
  collectionsMediaMobile   String?
  featuredMediaImageMobile String?
  featuredMediaMobile      String?
  flipbookImageMobile      String?
  flipbookVideoMobile      String?
  footerVideoMobile        String?
  loginBgImage             String?
  loginBgImageMobile       String?
  loginBgVideo             String?
  loginBgVideoMobile       String?
  loginBgImageDark         String?
  loginBgImageDarkMobile   String?
  loginBgImageLight        String?
  loginBgImageLightMobile  String?
  featuredMediaLink        String?
  flipbookLink             String?
  collectionsMediaLink     String?
  collectionProductOrders  String?    @default("{}")
  shopAllLink              String?    @default("/collections/all")
  feedExcludedCollections  String?    @default("[]")
  zicaAiSupportEnabled     Boolean    @default(true)
  zicaAiWhatsappEnabled    Boolean    @default(true)
  customers                Customer[]
  orders                   Order[]
  products                 Product[]
}

model ProductMoodBoard {
  id               String   @id @default(cuid())
  shopifyProductId String   @unique
  images           String   @default("[]")
  displayOrder     Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model Customer {
  id                      String             @id @default(cuid())
  shopId                  String
  shopifyId               String             @unique
  email                   String?
  name                    String?
  phone                   String?
  phoneLast10             String?
  defaultAddress          String?
  ordersCount             Int                @default(0)
  totalSpent              Float              @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  image                   String?
  region                  String?
  storeCredits            Float              @default(0)
  storeCreditPreference   Boolean            @default(false)
  emailOptedOut           Boolean            @default(false)
  smsOptedOut             Boolean            @default(false)
  whatsappOptedOut        Boolean            @default(false)
  lastLoginAt             DateTime?
  accountCreatedMsgSentAt DateTime?
  tokenVersion            Int                @default(0)
  addresses               Address[]
  communityMember         CommunityMember?
  communityMessages       CommunityMessage[]
  shop                    Shop               @relation(fields: [shopId], references: [id])
  following               Follow[]           @relation("UserFollowing")
  followers               Follow[]           @relation("UserFollowers")
  mobileOrders            MobileOrder[]
  orders                  Order[]
  payments                Payment[]
  profileHistory          ProfileHistory[]
  returns                 Return[]
  storeCreditTxns         StoreCredit[]
  wishlist                Wishlist[]
  carts                   Cart[]
  supportTickets          SupportTicket[]
  affiliate               Affiliate?

  @@index([phone])
  @@index([phoneLast10])
  @@index([email])
  @@index([name])
}

model Cart {
  id               String            @id @default(cuid())
  customerId       String?           @map("customer_id")
  sessionToken     String?           @unique @map("session_token")
  source           String            @default("webstore")
  status           String            @default("active")
  phone            String?           @map("phone_number")
  phoneLast10      String?           @map("phone_last_10")
  email            String?
  subtotal         Float             @default(0)
  currency         String            @default("INR")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  lastActivityAt   DateTime          @default(now()) @map("last_activity_at")
  abandonedAt      DateTime?         @map("abandoned_at")
  convertedOrderId String?           @unique @map("converted_order_id")
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  state            String?
  zip              String?
  items            CartItem[]
  convertedOrder   Order?            @relation("ConvertedOrder", fields: [convertedOrderId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsAppMessages WhatsAppMessage[]

  @@index([customerId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([source])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([phoneLast10])
  @@index([abandonedAt])
  @@map("cart_sessions")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_session_id")
  productId String   @map("shopify_product_id")
  variantId String?  @map("shopify_variant_id")
  handle    String?
  title     String?  @map("product_title")
  price     Float?
  image     String?  @map("image_url")
  quantity  Int
  size      String?  @map("variant_title")
  createdAt DateTime @default(now()) @map("added_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model ProfileHistory {
  id         String   @id @default(cuid())
  customerId String
  oldName    String?
  newName    String?
  oldEmail   String?
  newEmail   String?
  oldPhone   String?
  newPhone   String?
  oldImage   String?
  newImage   String?
  changedBy  String   @default("USER")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Customer @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Customer @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Order {
  id                    String             @id @default(cuid())
  shopId                String
  shopifyOrderId        String?            @unique
  customerId            String
  status                String
  totalPrice            Float
  subtotalPrice         Float?
  totalTax              Float?
  currency              String             @default("INR")
  displayCountry        String?            @map("display_country")
  paymentStatus         String
  fulfillmentStatus     String
  deliveryStatus        String             @default("pending")
  shippingAddress       String?
  billingAddress        String?
  note                  String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  orderType             String             @default("REGULAR")
  tags                  String?
  aiRiskRecommendation  String?
  codConfirmationMethod String?
  codConfirmationStatus String?
  codConfirmedAt        DateTime?
  paymentCapturedAt     DateTime?
  paymentMethod         String?
  razorpayOrderId       String?            @unique
  razorpayPaymentId     String?            @unique
  rtoRiskFactors        String?
  rtoRiskScore          Int?
  discountAmount        Float?             @default(0)
  storeCreditAmount     Float?             @default(0)
  discountCode          String?
  delhivery_awb         String?
  tracking_status       String?
  internalOrderNumber   String?            @unique @map("internal_order_number")
  shopifyOrderName      String?            @map("shopify_order_name")
  shopifySyncStatus     String             @default("synced") @map("shopify_sync_status")
  shopifySyncError      String?            @map("shopify_sync_error")
  refundStatus          String             @default("not_applicable") @map("refund_status")
  refundError           String?            @map("refund_error")
  refundAttempts        Int                @default(0) @map("refund_attempts")
  cancelledAt           DateTime?          @map("cancelled_at")
  cancelledBy           String?            @map("cancelled_by")
  refundId              String?            @unique @map("refund_id")
  paymentFailureReason  String?            @map("payment_failure_reason")
  previousOrderNumbers  String?            @map("previous_order_numbers")
  deliveredAt           DateTime?          @map("delivered_at")
  exchanges             Exchange[]
  exchangeRequests      ExchangeRequest[]
  customer              Customer           @relation(fields: [customerId], references: [id])
  shop                  Shop               @relation(fields: [shopId], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  returns               Return[]
  returnRequests        ReturnRequest[]
  shipments             Shipment[]
  cartSession           Cart?              @relation("ConvertedOrder")
  webhookEvents         WebhookEvent[]
  affiliateReferral     AffiliateReferral?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([orderType, createdAt])
  @@index([customerId, createdAt])
  @@index([refundStatus])
  @@index([shopifyOrderName])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  shopifyLineItemId String   @unique
  productId         String?
  title             String
  quantity          Int
  price             Float
  sku               String?
  image             String?
  variantId         String?
  variantTitle      String?
  size              String?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([sku])
}

model Product {
  id                String            @id @default(cuid())
  shopId            String
  shopifyProductId  String            @unique
  title             String
  includeInFeed     Boolean           @default(true)
  sku               String?
  barcode           String?
  inventoryItemId   String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  featuredImage     String?
  handle            String?
  price             Float?
  newExchanges      Exchange[]        @relation("NewProduct")
  originalExchanges Exchange[]        @relation("OriginalProduct")
  inventory         Inventory[]
  mobileOrderItems  MobileOrderItem[]
  orderItems        OrderItem[]
  shop              Shop              @relation(fields: [shopId], references: [id])
  returns           Return[]
  wishlist          Wishlist[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  locationId       String
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Return {
  id                String         @id @default(cuid())
  orderId           String
  productId         String
  customerId        String
  sku               String?
  quantity          Int            @default(1)
  reason            String
  status            String         @default("REQUESTED")
  requestedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  returnMethod      String?
  refundMethod      String?
  trackingNumber    String?
  refundAmount      Float?
  storeCreditAmount Float?
  refundStatus      String?
  returnRequestId   String?
  variantTitle      String?
  size              String?
  title             String?
  customer          Customer       @relation(fields: [customerId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id])
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

model ReturnRequest {
  id              String    @id @default(cuid())
  orderId         String
  customerId      String
  status          String    @default("pending_approval")
  estimatedRefund Float     @default(0)
  actualRefund    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  reason          String?
  reverseAwb      String?
  returns         Return[]
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Exchange {
  id                   String           @id @default(cuid())
  orderId              String
  originalProductId    String
  newProductId         String
  status               String           @default("REQUESTED")
  priceDifference      Float            @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  paymentStatus        String?
  newOrderId           String?
  exchangeRequestId    String?
  reason               String?
  qcStatus             String?          @default("pending")
  qcNotes              String?
  originalVariantTitle String?
  originalSize         String?
  newVariantTitle      String?
  newSize              String?
  exchangeRequest      ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id])
  newProduct           Product          @relation("NewProduct", fields: [newProductId], references: [id])
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalProduct      Product          @relation("OriginalProduct", fields: [originalProductId], references: [id])
}

model ExchangeRequest {
  id                   String     @id @default(cuid())
  orderId              String
  customerId           String
  status               String     @default("pending_approval")
  priceDifference      Float      @default(0)
  paymentStatus        String     @default("not_required")
  paymentId            String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  reason               String?
  returnRequestId      String?
  newShopifyOrderId    String?
  reverseAwb           String?
  settlementPreference String     @default("PREPAID_NOW")
  exchanges            Exchange[]
  order                Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String   @id @default(cuid())
  orderId      String
  customerId   String
  amount       Float
  type         String
  status       String
  gateway      String
  currencyCode String?  @default("INR") @map("currency_code")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                   String    @id @default(cuid())
  orderId              String
  trackingNumber       String?
  courier              String?
  status               String
  type                 String    @default("outbound")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  trackingUrl          String?
  currentLocation      String?
  estimatedDelivery    DateTime?
  events               String?   @default("[]")
  awb                  String?   @unique
  labelUrl             String?
  rawDelhiveryResponse String?
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, type])
  @@index([trackingNumber])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])

  @@index([source, eventType])
  @@index([createdAt])
  @@index([orderId])
}

model FeaturedUser {
  id               String   @id @default(cuid())
  orderId          String?
  name             String
  email            String
  imageUrl         String
  styleDescription String?
  isTopFeatured    Boolean  @default(false)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  instagramUrl     String?
  reviews          Review[]
}

model Review {
  id             String       @id @default(cuid())
  featuredUserId String
  reviewerName   String
  rating         Int          @default(5)
  comment        String?
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  featuredUser   FeaturedUser @relation(fields: [featuredUserId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id               String   @id @default(cuid())
  productId        String
  orderId          String
  userId           String
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean  @default(true)
  status           String   @default("VISIBLE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([status])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String
  coverImage      String?
  published       Boolean  @default(false)
  author          String   @default("Zica Bella")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  backlinkUrl     String?  @map("backlink_url")
  backlinkText    String?  @map("backlink_text")
  indexPref       Boolean  @default(true) @map("index_pref")
}

model CommunityMember {
  id            String    @id @default(cuid())
  customerId    String    @unique
  isVerified    Boolean   @default(false)
  status        String    @default("PENDING")
  phone         String?
  dob           DateTime?
  whatsappOptIn Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
}

model CommunityUpdate {
  id          String    @id @default(cuid())
  type        String    @default("EVENT")
  title       String
  description String?
  imageUrl    String?
  date        DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CommunityMessage {
  id         String         @id @default(cuid())
  customerId String
  content    String
  imageUrl   String?
  createdAt  DateTime       @default(now())
  reactions  ChatReaction[]
  customer   Customer       @relation(fields: [customerId], references: [id])
}

model ChatReaction {
  id         String           @id @default(cuid())
  messageId  String
  customerId String
  emoji      String           @default("❤️")
  createdAt  DateTime         @default(now())
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, customerId, emoji])
}

model ScanRecord {
  id           String   @id @default(cuid())
  productId    String?
  productTitle String?
  variantInfo  String?
  sku          String?
  barcode      String?
  actionType   String
  quantity     Int      @default(1)
  beforeStock  Int?
  afterStock   Int?
  locationId   String?
  staffName    String   @default("Admin")
  createdAt    DateTime @default(now())
}

model MfgFabric {
  id                      String               @id @default(cuid())
  sku                     String               @unique
  name                    String
  costPerMeter            Float
  weightValue             Float                @default(0)
  weightUnit              String               @default("kg")
  totalMeters             Float                @default(0)
  status                  String               @default("ACTIVE")
  lowStockMetersThreshold Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  movements               MfgFabricMovement[]
  productionBatches       MfgProductionBatch[]
}

model MfgFabricMovement {
  id                 String              @id @default(cuid())
  fabricId           String
  occurredAt         DateTime            @default(now())
  type               String
  quantity           Float
  quantityUnit       String
  rateAtMovement     Float
  totalValue         Float
  remarks            String?
  createdByName      String              @default("Admin")
  correctsMovementId String?
  productionBatchId  String?
  balanceMetersAfter Float?
  balanceWeightAfter Float?
  createdAt          DateTime            @default(now())
  fabric             MfgFabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  batch              MfgProductionBatch? @relation(fields: [productionBatchId], references: [id])

  @@index([fabricId, occurredAt])
  @@index([productionBatchId])
}

model MfgProductionBatch {
  id                   String                  @id @default(cuid())
  batchCode            String                  @unique @map("batch_code")
  productName          String                  @map("product_name")
  quantity             Int
  currentStage         String                  @map("current_stage")
  washCostTotal        Float                   @default(0) @map("wash_cost_total")
  fabricId             String?                 @map("fabric_id")
  notes                String?
  estimatedCostPerUnit Float?                  @map("estimated_cost_per_unit")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  isCuttingDone        Boolean                 @default(false) @map("is_cutting_done")
  isEmbroideryDone     Boolean                 @default(false) @map("is_embroidery_done")
  isPrintingDone       Boolean                 @default(false) @map("is_printing_done")
  isSampleDone         Boolean                 @default(false) @map("is_sample_done")
  isWashingDone        Boolean                 @default(false) @map("is_washing_done")
  isStitchingDone      Boolean                 @default(false) @map("is_stitching_done")
  workdriveFolderId    String?                 @map("workdrive_folder_id")
  workdriveUrl         String?                 @map("workdrive_url")
  workdriveFolderName  String?                 @map("workdrive_folder_name")
  batchNotes           MfgBatchNote[]
  movements            MfgFabricMovement[]
  miscExpenses         MfgMiscExpense[]
  stageLogs            MfgProductionStageLog[]
  fabric               MfgFabric?              @relation(fields: [fabricId], references: [id])
  tasks                MfgTask[]

  @@map("manufacturing_batches")
}

model MfgTask {
  id                  String              @id @default(cuid())
  title               String
  description         String?
  status              String              @default("PENDING")
  priority            String              @default("MEDIUM")
  dueDate             DateTime?           @map("due_date")
  completedAt         DateTime?           @map("completed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  createdByName       String              @default("Admin") @map("created_by_name")
  batchId             String?             @map("batch_id")
  approvalStatus      String?             @map("approval_status")
  assignedToId        String?             @map("assigned_to_id")
  designImage         String?             @map("design_image")
  designName          String?             @map("design_name")
  type                String              @default("MANUAL")
  workdriveFolderId   String?             @map("workdrive_folder_id")
