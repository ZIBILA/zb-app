# ─── SNAPCHAT PIXEL & CONVERSIONS API ───────────────────────
# Full guide: docs/snap-tracking-setup.md
#
# REQUIRED on the server (DigitalOcean → App-Level Environment Variables, encrypted).
# Conversions API token of the Snap Pixel: Snapchat Ads Manager → Business Details →
# Conversions API Tokens (Organization Admin). Paste it as ONE line, without quotes.
# Without it no server event (including Purchase) reaches Snapchat — the retry
# endpoint then reports "snap_config_missing". NEVER commit a real token.
SNAP_CAPI_ACCESS_TOKEN=""

# OPTIONAL. The Snap Pixel ID (a UUID). When unset, a production build uses the store's
# own pixel (lib/snap/config.ts) and development / test builds send nothing to Snapchat.
# Set it to try Snap tracking locally, or to "off" to switch Snap tracking off for a
# deployment (e.g. staging). Read at BUILD time (NEXT_PUBLIC_*).
# NEXT_PUBLIC_SNAP_PIXEL_ID=""

# OPTIONAL, staging only: send every event to Snapchat's /events/validate endpoint
# (the payload is checked, NOTHING is recorded). Ignored on zicabella.com,
# www.zicabella.com and app.zicabella.com.
# SNAP_CAPI_VALIDATE="1"

# OPTIONAL, native iOS / Android app Purchases (docs/snap-native-app-setup.md).
# SNAP_APP_ID_IOS=""
# SNAP_APP_ID_ANDROID=""
# SNAP_IOS_APP_STORE_ID=""
# SNAP_ANDROID_PACKAGE="com.zicabella.app"
# SNAP_APP_CAPI_ACCESS_TOKEN=""   # falls back to SNAP_CAPI_ACCESS_TOKEN

# ─── OPENAI / CHATGPT ADS PIXEL & CONVERSIONS API ──────────
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID="0000000000000"
OPENAI_ADS_CAPI_KEY="oaap_0000000000000000000000000000"

